# Copy to .env and fill in locally. Never commit real secrets.
APP_ENV=local

# Postgres is the deployment target. The default points at docker-compose.
DATABASE_URL=postgresql+psycopg://opspilot:opspilot@localhost:5432/opspilot

# For a quick run without Postgres (same models, SQLite file):
# DATABASE_URL=sqlite+pysqlite:///./opspilot.db

# Model access. LLM_PROVIDER=mock runs the workflow offline with fixture replies (no API calls).
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-replace-me
# Any OpenAI-compatible endpoint can be used instead of the default one:
# LLM_BASE_URL=http://localhost:11434/v1
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Runbook embeddings. EMBEDDING_PROVIDER=mock uses deterministic hashed vectors (offline only).
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# Cosine distance cutoff; chunks above it are treated as irrelevant.
RUNBOOK_MAX_DISTANCE=0.75

# Approvals are a privileged action: requests need the X-API-Key header.
APPROVAL_API_KEY=replace-with-a-long-random-value
APPROVAL_ACTOR=oncall-engineer

# LangGraph checkpoints use a psycopg DSN. Defaults to DATABASE_URL when unset.
# CHECKPOINT_DATABASE_URL=postgresql://opspilot:opspilot@localhost:5432/opspilot

# docker-compose only: the database password and the operator key are required.
POSTGRES_PASSWORD=replace-with-a-long-random-value

# LangSmith tracing is off unless explicitly enabled. Traces contain incident text.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=opspilot
# Self-hosted LangSmith only:
# LANGSMITH_ENDPOINT=http://localhost:1984

